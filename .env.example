# =============================================================================
# FILO - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control
#
# ARCHITECTURE:
#   Next.js = UI layer only (minimal env vars)
#   Convex = Backend + Database + Secrets + Integrations
#   R2 = File storage
#   OpenRouter = Beta AI provider
#   Safepay = Payment gateway
# =============================================================================

# -----------------------------------------------------------------------------
# NEXT.JS (Frontend - Public Only)
# -----------------------------------------------------------------------------
# These are the ONLY variables exposed to the browser via NEXT_PUBLIC_*
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud
NODE_ENV=development

# Convex URL for server-side API routes (same as NEXT_PUBLIC_CONVEX_URL)
CONVEX_URL=https://your-project.convex.cloud

# -----------------------------------------------------------------------------
# CONVEX SECRETS (Server-Side Only)
# -----------------------------------------------------------------------------
# Configure these in your Convex dashboard: https://dashboard.convex.dev
# These are NEVER exposed to the browser

# AI Providers (OpenRouter for beta, OpenAI for future)
OPENROUTER_API_KEY=sk-or-your-openrouter-key
OPENAI_API_KEY=sk-your-openai-key

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=filo-uploads

# Safepay Payment Gateway
SAFEPAY_PUBLIC_KEY=your-safepay-public-key
SAFEPAY_SECRET_KEY=your-safepay-secret-key
SAFEPAY_WEBHOOK_SECRET=your-safepay-webhook-secret
SAFEPAY_SANDBOX=true

# Admin Panel (HTTP-only cookie auth)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-secure-password
ADMIN_SESSION_SECRET=your-admin-session-secret-key
