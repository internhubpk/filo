# =============================================================================
# FILO — Environment Configuration (definitive)
# =============================================================================
# Copy to .env and fill in real values. NEVER commit the real .env file.
#
# ARCHITECTURE:
#   Next.js (Vercel) = UI + API routes (the authz boundary; ALL Safepay calls)
#   Convex           = Database + realtime + AI worker (source of truth)
#   R2               = Cloudflare file storage (uploaded by the Next.js app)
#   OpenAI           = PRODUCTION AI provider — DIRECT api.openai.com, the
#                      operator's own key, NO AgentRouter gateway
#   Agent Router     = optional dev/gateway provider (never required in prod)
#   Safepay          = subscription billing (sandbox by default)
#
# SECURITY RULES:
#   - Secrets must NEVER reach the browser. Everything prefixed NEXT_PUBLIC_
#     is public — keep it that way.
#   - Safepay credentials are read EXCLUSIVELY by src/lib/safepay/config.ts
#     (server-only). FILO_SERVER_SECRET is the Next.js → Convex trust token.
#
# VARIABLE MATRIX (which runtime needs what):
# -----------------------------------------------------------------------------
#  Variable                  | Vercel | Convex | Public? | Required
#  --------------------------+--------+--------+---------+------------------
#  NEXT_PUBLIC_APP_URL       |   ✅   |   —    | public  | required (prod)
#  NEXT_PUBLIC_CONVEX_URL    |   ✅   |   —    | public  | required
#  NEXT_PUBLIC_CONVEX_SITE_URL|  ✅   |   —    | public  | optional
#  CONVEX_URL                |   ✅   |   —    | secret  | required (server)
#  CONVEX_DEPLOYMENT         |   ✅   |   —    | secret  | set by Convex CLI
#  FILO_SERVER_SECRET        |   ✅   |   ✅   | secret  | required (SAME value)
#  SESSION_SECRET            |   ✅   |   —    | secret  | recommended
#  SAFEPAY_PUBLIC_KEY        |   ✅   |   —    | secret  | optional (reserved)
#  SAFEPAY_SECRET_KEY        |   ✅   |   —    | secret  | required (billing)
#  SAFEPAY_WEBHOOK_SECRET    |   ✅   |   —    | secret  | required (prod)
#  SAFEPAY_SANDBOX           |   ✅   |   —    | public  | required (true/false)
#  SAFEPAY_PAYMENT_MODEL     |   ✅   |   —    | public  | optional (default subscription)
#  SAFEPAY_ALLOW_UNSIGNED_WEBHOOKS | ✅|   —    | public  | dev only
#  AGENT_ROUTER_API_KEY      |   ✅   |   ✅   | secret  | optional (dev gateway)
#  AGENT_ROUTER_BASE_URL     |   ✅   |   ✅   | secret  | optional
#  GEMINI_API_KEY            |   ✅   |   ✅   | secret  | optional (dev default)
#  GEMINI_BASE_URL           |   ✅   |   ✅   | secret  | optional
#  OPENAI_API_KEY            |   ✅   |   ✅   | secret  | required (PRODUCTION —
#                            |       |       |         | direct api.openai.com)
#  R2_ACCOUNT_ID / _ACCESS_KEY_ID / _SECRET_ACCESS_KEY / _BUCKET_NAME
#                            |   ✅   |   —    | secret  | required (files+render)
#  (R2 runs on the Next.js runtime: /api/files, /api/files/signed-url,
#   /api/files/[fileId]/download and /api/generation/render upload rendered
#   documents to R2. The Convex worker never calls R2 directly — it POSTs to
#   /api/generation/render on the app, which does the upload.)
#  ADMIN_USERNAME / _PASSWORD / _EMAIL / ADMIN_SESSION_SECRET
#                            |   —    |   ✅   | secret  | required (admin)
# ===============================================================================

# -----------------------------------------------------------------------------
# NEXT.JS (Vercel) — public
# -----------------------------------------------------------------------------
# The STABLE production origin (NOT a per-deployment URL like
# `project-abc123.vercel.app` — those die on the next deploy and break the
# Safepay return redirect with a 404 DEPLOYMENT_NOT_FOUND).
NEXT_PUBLIC_APP_URL=https://your-stable-domain.vercel.app
# Browser Convex client (public deployment URL — safe to expose).
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud
# Convex HTTP actions site URL, if Convex functions are exposed over HTTP.
# NEXT_PUBLIC_CONVEX_SITE_URL=https://your-project.convex.site

# -----------------------------------------------------------------------------
# NEXT.JS (Vercel) — server-only
# -----------------------------------------------------------------------------
# Server-side Convex connection (used by API routes; provided automatically by
# `npx convex dev`/`npx convex deploy` and available in Vercel env).
CONVEX_URL=https://your-project.convex.cloud

# Cloudflare R2 — REQUIRED on this runtime for file storage + document
# rendering (the render step uploads the finished document to R2; missing or
# broken R2 vars surface as HTTP 503 "File storage temporarily unavailable"
# and generation jobs keep retrying instead of completing).
#   R2_ACCOUNT_ID=your-cloudflare-account-id        (Cloudflare dashboard → R2)
#   R2_ACCESS_KEY_ID=your-r2-token-access-key       (R2 → Manage API Tokens)
#   R2_SECRET_ACCESS_KEY=your-r2-token-secret
#   R2_BUCKET_NAME=filo-uploads

# Shared secret between Next.js API routes and Convex privileged functions.
# MUST be the SAME value in Vercel AND Convex (`npx convex env set
# FILO_SERVER_SECRET ...`). Billing and admin mutations verify it fail-closed.
# LOCAL DEV: if this is missing from .env.local, document RENDERING cannot run
# — generation jobs stick at 97% ("rendering") and the progress card tells you
# exactly this. Set the SAME value here and in Convex; also set the R2_*
# variables (below) — the rendered file is uploaded to R2.
FILO_SERVER_SECRET=generate-a-long-random-string

# Extra hardening for user session HMAC tokens (falls back to CONVEX_URL).
SESSION_SECRET=generate-another-long-random-string

# -----------------------------------------------------------------------------
# SAFEPAY (Vercel — server-only; read ONLY by src/lib/safepay/config.ts)
# -----------------------------------------------------------------------------
# Exactly the three credentials the merchant dashboard shows:
#   Public API Key · Private API Secret Key · Private Webhook Secret Key
# WHERE TO FIND THEM (per current docs, safepay-docs.netlify.app → Developers
# → API keys): log in to the dashboard matching SAFEPAY_SANDBOX, open
# dashboard/developers/api.
#   1st item = Public API Key   (starts with "sec_")
#   2nd item = Private API Secret Key  ← THIS is SAFEPAY_SECRET_KEY
# Webhook secret: Developers → Endpoints → "View shared secret".
# ⚠ Sandbox and production accounts have DIFFERENT keys — never mix.
# ⚠ Do NOT paste the Public API Key (sec_…) into SAFEPAY_SECRET_KEY; Safepay
#   rejects it with "strategies/secret: could not fetch client".

# Dashboard "Public API Key" (starts with sec_…) — a public account
# identifier, NOT a secret. Filo's server flow does not use it today;
# configured for completeness so the credential mapping stays explicit.
SAFEPAY_PUBLIC_KEY=sec_your-public-key

# Dashboard "Private API Secret Key" — the SECOND item on
# dashboard/developers/api. REQUIRED. Sent as the X-SFPY-MERCHANT-SECRET
# header for /client/passport/v1/token (subscriptions), /client/plans/v1/
# (plan creation) and /reporter/api/v1/payments/{tracker} (Fetch Tracker
# verification). Checkout is fail-closed without it.
SAFEPAY_SECRET_KEY=paste-the-private-api-secret-key-here

# Dashboard "Private Webhook Secret Key" — REQUIRED in production (Developers
# → Endpoints → View shared secret). Verifies webhook signatures
# (X-SFPY-SIGNATURE header, HMAC-SHA512 hex over the JSON payload) and the
# signed browser return (HMAC-SHA256 hex over the tracker — the official
# WooCommerce plugin's proof-of-payment scheme). Fail-closed.
SAFEPAY_WEBHOOK_SECRET=your-webhook-shared-secret

# Environment mode: "true" → sandbox endpoints (default), "false" →
# production endpoints. Never mix sandbox credentials with production
# endpoints or vice-versa.
SAFEPAY_SANDBOX=true

# Payment model: "subscription" (default — true recurring billing via
# Safepay-managed plans; requires running Admin → Plans → "Sync Safepay
# plans") or "one_time" (explicit opt-in; each period is charged manually and
# verified via the Fetch Tracker API). Checkout NEVER silently downgrades
# from subscription to one-time.
# SAFEPAY_PAYMENT_MODEL=subscription

# DEV ONLY: accept unsigned webhooks for local curl testing. NEVER true in
# production.
SAFEPAY_ALLOW_UNSIGNED_WEBHOOKS=false

# -----------------------------------------------------------------------------
# AI PROVIDER STRATEGY (rebuild v2) — ONE provider per environment, no cross-provider fallback chains.
# Selection order:
#   1. AI_PROVIDER env (GEMINI | OPENAI | AGENT_ROUTER) — explicit, wins, and
#      is ABSOLUTE: pinned models are served by that provider DIRECTLY (a
#      shared gateway listing the same model id can never hijack a request).
#   2. Exactly one key configured → that provider.
#   3. Default: production (NODE_ENV=production) → OPENAI, development → GEMINI.
#
#   DEVELOPMENT: Gemini only  → set GEMINI_API_KEY (below) and leave the rest.
#   PRODUCTION:  OpenAI DIRECT (no AgentRouter) →
#     Vercel:  AI_PROVIDER=OPENAI, OPENAI_API_KEY=sk-...
#     Convex:  npx convex env set AI_PROVIDER openai
#              npx convex env set OPENAI_API_KEY sk-...
#     The AgentRouter key is NOT needed in production; remove it from Vercel
#     if it is still set from earlier testing.
#
# The provider abstraction lives in src/services/ai/ (server-side only).
# Keys are read lazily at call time and NEVER reach the browser.
#
# GENERATION RUNS IN CONVEX ACTIONS, so the AI keys MUST exist in the CONVEX
# environment (npx convex env set ...). Vercel copies are only needed so the
# enqueue/retry routes can forward keys to the worker when Convex env keys
# are missing. NEVER create NEXT_PUBLIC_* variants (server-side only).
# Verify from the real runtime: Admin → Plans → "Run live AI probe"
# (GET/POST /api/admin/ai/status) — reports config/HTTP status/latency,
# never the keys themselves.
#
# AI_PROVIDER is optional; set it in BOTH Vercel and Convex when you want to
# pin the provider explicitly:
#   npx convex env set AI_PROVIDER gemini      # (or openai)
# -----------------------------------------------------------------------------
# CHAT WEB SEARCH GROUNDING (Next.js/Vercel runtime ONLY — Convex env NOT
# needed). "true" asks the chat provider to ground replies in live web
# results and attach native citations, rendered as the "Web resources" strip:
#   GEMINI  → google_search tool → groundingMetadata (all 3.x models)
#   OPENAI  → web_search_options on search-capable models (…-search-preview,
#             gpt-5 family — a rejection is remembered and skipped); other
#             models fail-soft to link extraction (no behavior change)
# Document generation is NEVER grounded regardless of this flag. Grounding
# adds search-tool cost/latency per chat turn — enable deliberately.
# CHAT_WEB_SEARCH=true
# -----------------------------------------------------------------------------
# CHAT MODEL PIN (Next.js/Vercel runtime ONLY — Convex env NOT needed).
# Pins the model used for CHAT replies in /api/chat/send (document generation
# keeps its own cost-optimized task matrix). The pinned id is served DIRECTLY
# by the strategy provider — production (OpenAI) needs ONLY OPENAI_API_KEY:
#   CHAT_MODEL=gpt-5.6-sol      → DIRECT via api.openai.com (OPENAI_API_KEY)
#   CHAT_MODEL=gpt-5.6          → DIRECT via api.openai.com (OPENAI_API_KEY)
#   CHAT_MODEL=gemini-3.6-flash → routes to Gemini (needs GEMINI_API_KEY;
#                                 dev convenience — never required in prod)
# gpt-5.x/o-series requests are sent reasoning-compatible automatically
# (max_completion_tokens, no temperature/top_p) and a 400 self-heal ladder
# adapts unknown rejections per model. Leave unset for the per-provider
# default/task matrix. A client-supplied model (chat request body "model")
# overrides this env — wired for a future UI picker.
# CHAT_MODEL=gpt-5.6-sol
# -----------------------------------------------------------------------------
# CHAT REASONING DEPTH (Next.js/Vercel runtime ONLY). Thinking models
# (gpt-5.x / o-series) spend time reasoning before the first visible token;
# 'low' makes chat replies start in ~ms instead of seconds of "Thinking…".
# One of: minimal | low | medium | high (default: low). Document generation
# keeps the provider default — only chat is tuned for snappiness.
# CHAT_REASONING_EFFORT=low
# -----------------------------------------------------------------------------
#   npx convex env set AGENT_ROUTER_API_KEY sk-your-agentrouter-key   (OPTIONAL —
# dev/gateway use only; production talks to OpenAI directly and does NOT need
# this key. If it is still configured somewhere, an explicit AI_PROVIDER=OPENAI
# keeps every request on the operator's own OpenAI credential anyway.)
# Key comes from the AgentRouter console (https://agentrouter.org → console/token).
#
# ⚠ THE OpenAI-COMPATIBLE ENDPOINT IS THE `co.` HOST:
#     https://co.agentrouter.org/v1        ← the real API (verified live:
#                                            /v1/models returns 401 JSON)
#     https://agentrouter.org              ← marketing/docs site; its API
#                                            paths return an Aliyun-WAF
#                                            anti-bot HTML page to servers
# The adapter defaults to co.agentrouter.org/v1. Override
# AGENT_ROUTER_BASE_URL only when routing through a self-hosted proxy.
AGENT_ROUTER_API_KEY=
# AGENT_ROUTER_BASE_URL=https://co.agentrouter.org/v1
# Models (cost order): deepseek-v4-flash, glm-5.3, gpt-5.6-sol,
# claude-opus-4-8, claude-opus-5

# DEVELOPMENT DEFAULT — Google Gemini (direct Generative Language API).
#   npx convex env set GEMINI_API_KEY AIza...
# Key comes from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Leave GEMINI_BASE_URL UNSET for Google's public endpoint.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Models (cost order): gemini-3.5-flash-lite, gemini-3.6-flash,
# gemini-3.1-pro-preview  (2.5 family retired by Google for new deployments)

# PRODUCTION DEFAULT (NODE_ENV=production without an explicit AI_PROVIDER) —
# DIRECT api.openai.com. Never proxied through AgentRouter.
OPENAI_API_KEY=
# Models (registry): gpt-5.6-sol, gpt-5.6 (reasoning — served compatibly),
# gpt-4o-mini, gpt-4o, gpt-4.1-mini, gpt-4.1

# -----------------------------------------------------------------------------
# CONVEX — set with `npx convex env set ...` (server-side only)
# -----------------------------------------------------------------------------
# R2 object storage (runs on the NEXT.JS runtime — set these in Vercel env
# AND in .env.local; Convex does NOT need them):
#   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME
# Token policy: create an R2 API token with "Object Read & Write" scoped to
# the bucket; keep the bucket PRIVATE (app uses presigned S3 URLs, no public
# access). If the browser presigned-upload path is used, configure a CORS
# policy on the bucket (PUT/GET/HEAD from the app origin). Verify live via
# Admin console → POST /api/admin/r2/status (reports config + probe result,
# never the credentials themselves).
# Admin bootstrap + verification:
#   ADMIN_USERNAME, ADMIN_PASSWORD, ADMIN_EMAIL, ADMIN_SESSION_SECRET
# Mirror from the shared-secret section:
#   FILO_SERVER_SECRET (SAME value as Vercel)
# NOTE: Safepay credentials are NOT needed in Convex — Convex never calls
# Safepay. All gateway communication lives in the Next.js API routes.
