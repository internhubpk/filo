# =============================================================================
# FILO - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control
#
# ARCHITECTURE:
#   Next.js = UI layer only (minimal env vars)
#   Convex = Backend + Database + Secrets + Integrations
#   R2 = File storage
#   Gemini = PRIMARY AI provider (OpenRouter/OpenAI = optional fallbacks)
#   Billing = none (payments removed; signups are activated instantly)
# =============================================================================

# -----------------------------------------------------------------------------
# NEXT.JS (Frontend - Public Only)
# -----------------------------------------------------------------------------
# These are the ONLY variables exposed to the browser via NEXT_PUBLIC_*
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud
NODE_ENV=development

# Convex URL for server-side API routes (same as NEXT_PUBLIC_CONVEX_URL)
CONVEX_URL=https://your-project.convex.cloud

# -----------------------------------------------------------------------------
# CONVEX SECRETS (Server-Side Only)
# -----------------------------------------------------------------------------
# Configure these in your Convex dashboard: https://dashboard.convex.dev
# (npx convex env add GEMINI_API_KEY ...) AND in your hosting platform
# (Vercel Project Settings → Environment Variables) — both runtimes need them:
#   - Convex actions call AI (convex/artifacts.ts generateArtifact)
#   - Next.js API routes call AI (agent-generate route)

# ---- AI: PRIMARY PROVIDER (Google Gemini) ----
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional overrides:
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-2.0-flash

# ---- AI: OPTIONAL FALLBACK PROVIDERS ----
# The AI router falls back to these ONLY if Gemini is unconfigured or fails.
# Core generation does NOT require either of them.
OPENROUTER_API_KEY=sk-or-your-openrouter-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=filo-uploads

# Admin Panel (HTTP-only cookie auth)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-secure-password
ADMIN_SESSION_SECRET=your-admin-session-secret-key

# NOTE: All payment integrations (SafePay + manual verification flow) have
# been REMOVED. There are no payment env vars. Every signup is activated
# instantly and quota is enforced via the usageRecords table.
