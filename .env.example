# =============================================================================
# FILO - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control
#
# ARCHITECTURE:
#   Next.js = UI layer + API routes (authz boundary)
#   Convex  = Database + realtime + AI actions (source of truth)
#   R2      = Cloudflare file storage
#   Gemini  = PRIMARY AI provider (OpenRouter/OpenAI = optional fallbacks)
#   Safepay = subscription billing (sandbox by default)
#
# SECURITY RULE: FILO_SERVER_SECRET and SAFEPAY secrets must NEVER reach the
# browser. Everything prefixed NEXT_PUBLIC_ is public — keep it that way.
# =============================================================================

# -----------------------------------------------------------------------------
# NEXT.JS (Frontend - Public Only)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud
NODE_ENV=development

# Convex URL for server-side API routes (same as NEXT_PUBLIC_CONVEX_URL)
CONVEX_URL=https://your-project.convex.cloud

# -----------------------------------------------------------------------------
# SERVER ↔ CONVEX SHARED SECRET (required for billing)
# -----------------------------------------------------------------------------
# Long random string. Set the SAME value in two places:
#   1. Here (Next.js runtime) — sent as `serverToken` by API routes.
#   2. Convex env (`npx convex env set FILO_SERVER_SECRET ...`).
# Every billing mutation verifies it fail-closed: without it, billing is
# disabled and entitlements can never be granted.
FILO_SERVER_SECRET=generate-a-long-random-string

# -----------------------------------------------------------------------------
# CONVEX SECRETS (set with `npx convex env set ...` AND in your hosting
# platform for the Next.js runtime where noted)
# -----------------------------------------------------------------------------

# ---- AI: PRIMARY PROVIDER (Google Gemini) ----
# Get a key at https://aistudio.google.com/apikey
#
# BACKGROUND GENERATION: AI calls run inside a Convex worker (survives tab
# close / logout; also the fix for Vercel 504s). Set the key on BOTH runtimes:
#   1. Vercel (this file's vars) — used by the API layer and as a pass-through
#      fallback for the Convex worker.
#   2. Convex (RECOMMENDED so the key is never passed through function args):
#        npx convex env set GEMINI_API_KEY your-gemini-api-key
#        npx convex env set FILO_SERVER_SECRET <same value as above>
GEMINI_API_KEY=your-gemini-api-key
# Optional overrides:
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-2.0-flash

# ---- AI: OPTIONAL FALLBACK PROVIDERS ----
# The AI router falls back to these ONLY if Gemini is unconfigured or fails.
OPENROUTER_API_KEY=sk-or-your-openrouter-key
OPENAI_API_KEY=sk-your-openai-key

# -----------------------------------------------------------------------------
# CLOUDFLARE R2 STORAGE
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=filo-uploads

# -----------------------------------------------------------------------------
# ADMIN PANEL (env-credential admin)
# -----------------------------------------------------------------------------
# These credentials create/bootstrap the admin identity. ADMIN_USERNAME and
# ADMIN_PASSWORD must ALSO be set in the Convex environment
# (`npx convex env set ADMIN_USERNAME ...`) so the bootstrap action can
# re-verify them server-side.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-secure-password
ADMIN_EMAIL=admin@filo.app
ADMIN_SESSION_SECRET=generate-another-long-random-string

# Optional extra hardening for user session HMAC tokens (falls back to
# CONVEX_URL if unset — set it in production):
SESSION_SECRET=generate-a-third-long-random-string

# -----------------------------------------------------------------------------
# SAFEPAY SUBSCRIPTION BILLING (sandbox)
# -----------------------------------------------------------------------------
# SAFEPAY_MODE: sandbox (default) | production
#   Sandbox API:  https://sandbox.api.getsafepay.com
#   Sandbox page: https://sandbox.api.getsafepay.com/checkout/pay?beacon={token}
#   Production:   https://api.getsafepay.com  /  https://getsafepay.com/checkout
SAFEPAY_MODE=sandbox

# Merchant beacon/secret key from the Safepay dashboard (server-side only!)
# Used as `client` for POST /order/v1/init (one-time payment flow).
SAFEPAY_BEACON_SECRET=sec_your-safepay-beacon-secret

# OPTIONAL — merchant v1 secret (Safepay dashboard > Developers). Enables the
# TRUE recurring subscription checkout (/checkout/subscribe with a plan_id
# created in the Safepay dashboard). Without it, checkout falls back to the
# one-time payment flow; the webhook still activates the subscription.
SAFEPAY_V1_SECRET=your-safepay-v1-merchant-secret

# Webhook signing secret. REQUIRED in production — webhook deliveries with
# an invalid or missing signature are rejected with 401 (fail-closed).
# Get it from the Safepay dashboard > Developers > Webhooks.
# Accepted webhook signature schemes: official @sfpy/node-sdk v3
# (hex HMAC-SHA512 over JSON.stringify(body.data), `x-sfpy-signature`
# header) AND HMAC-SHA256 over the raw body (hex or base64).
SAFEPAY_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# DEV ONLY: allow unsigned webhooks for local curl testing. NEVER true in
# production.
SAFEPAY_ALLOW_UNSIGNED_WEBHOOKS=false

# -----------------------------------------------------------------------------
# SAFEPAY WEBHOOK ENDPOINT
# -----------------------------------------------------------------------------
# Register this URL in the Safepay merchant dashboard:
#
#   Development:  http://localhost:3000/api/webhooks/safepay
#   Production:   https://YOUR_REAL_DOMAIN/api/webhooks/safepay
#
# NOTE: webhook delivery is no longer the ONLY confirmation path — payments
# are also confirmed by the signed redirect POST (official Safepay flow) and
# by polling Safepay's Fetch Tracker API from /api/billing/verify. Register
# the webhook anyway so cancellations/refunds/subscriptions stay in sync.
# Supported events (handled by the billing state machine):
#   payment:created, refund:created, error:occurred
#   payment.succeeded | payment.failed | payment.refunded
#   payment.disputed | payment.dispute.won | payment.dispute.lost
#   authorization.succeeded | authorization.reversed | void.succeeded
#   subscription.created | subscription.updated | subscription.canceled
#   subscription.ended | subscription.unpaid | subscription.paused
#   subscription.resumed | subscription.payment.succeeded
#   subscription.payment.failed
#
# Subscription plan identifiers: create recurring plans (e.g. pro-monthly,
# pro-yearly, team-monthly, team-yearly) in the Safepay dashboard, then map
# them to Filo plans either in the admin console (Plans) or via the seed
# script (`npm run convex:seed`). Checkout refuses unmapped plans (fail-closed).
# -----------------------------------------------------------------------------
