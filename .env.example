# =============================================================================
# Filo AI - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Application Basics
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=file:./dev.db

# -----------------------------------------------------------------------------
# Convex (Real-time Backend)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CONVEX_URL=https://your-convex-site.convex.cloud

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Admin Panel Authentication
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-secure-password
ADMIN_SESSION_SECRET=your-admin-session-secret-key

# -----------------------------------------------------------------------------
# AI Services (OpenRouter / OpenAI)
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# Cloudflare R2 Storage
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT=
R2_BUCKET_NAME=filo-uploads
CLOUDFLARE_R2_ACCOUNT_ID=your-r2-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET=filo-artifacts
CLOUDFLARE_R2_PUBLIC_URL=https://pub-your-account-id.r2.dev

# -----------------------------------------------------------------------------
# SafePay Payment Gateway
# -----------------------------------------------------------------------------
SAFEPAY_PUBLIC_KEY=your-safepay-public-key
SAFEPAY_SECRET_KEY=your-safepay-secret-key
SAFEPAY_SANDBOX=true
SAFEPAY_WEBHOOK_SECRET=your-safepay-webhook-secret

# -----------------------------------------------------------------------------
# PayFast Payment Gateway
# -----------------------------------------------------------------------------
PAYFAST_MERCHANT_ID=your-payfast-merchant-id
PAYFAST_MERCHANT_KEY=your-payfast-merchant-key
PAYFAST_PASSPHRASE=your-payfast-passphrase
PAYFAST_IS_SANDBOX=true
NEXT_PUBLIC_PAYFAST_MERCHANT_ID=
NEXT_PUBLIC_PAYFAST_MERCHANT_KEY=
NEXT_PUBLIC_PAYFAST_SANDBOX=true

# -----------------------------------------------------------------------------
# Plan Configuration (Optional - overrides defaults)
# -----------------------------------------------------------------------------
# Pro Plan
NEXT_PUBLIC_PLAN_PRO_ID=pro
NEXT_PUBLIC_PLAN_PRO_NAME=Pro
NEXT_PUBLIC_PLAN_PRO_DESC=For individual professionals and power users
NEXT_PUBLIC_PLAN_PRO_MONTHLY_PRICE=190
NEXT_PUBLIC_PLAN_PRO_YEARLY_PRICE=1900
NEXT_PUBLIC_PLAN_PRO_FEATURE_1=500 AI generations per month
NEXT_PUBLIC_PLAN_PRO_FEATURE_2=5GB cloud storage
NEXT_PUBLIC_PLAN_PRO_FEATURE_3=All document types (DOCX, PDF, XLSX, PPTX)
NEXT_PUBLIC_PLAN_PRO_FEATURE_4=Priority processing queue
NEXT_PUBLIC_PLAN_PRO_FEATURE_5=Custom brand profiles
NEXT_PUBLIC_PLAN_PRO_FEATURE_6=Advanced export formats
NEXT_PUBLIC_PLAN_PRO_FEATURE_7=Email support (48hr response)
NEXT_PUBLIC_PLAN_PRO_FEATURE_8=No watermarks on exports
NEXT_PUBLIC_PLAN_PRO_LIMIT_1=Single user account
NEXT_PUBLIC_PLAN_PRO_LIMIT_2=Standard API access

# Team Plan
NEXT_PUBLIC_PLAN_TEAM_ID=team
NEXT_PUBLIC_PLAN_TEAM_NAME=Team
NEXT_PUBLIC_PLAN_TEAM_DESC=For small teams and growing businesses
NEXT_PUBLIC_PLAN_TEAM_MONTHLY_PRICE=490
NEXT_PUBLIC_PLAN_TEAM_YEARLY_PRICE=4900
NEXT_PUBLIC_PLAN_TEAM_FEATURE_1=2,500 AI generations per month (shared)
NEXT_PUBLIC_PLAN_TEAM_FEATURE_2=25GB cloud storage (shared)
NEXT_PUBLIC_PLAN_TEAM_FEATURE_3=Up to 5 team members
NEXT_PUBLIC_PLAN_TEAM_FEATURE_4=All document types + custom templates
NEXT_PUBLIC_PLAN_TEAM_FEATURE_5=Team collaboration features
NEXT_PUBLIC_PLAN_TEAM_FEATURE_6=Admin dashboard & controls
NEXT_PUBLIC_PLAN_TEAM_FEATURE_7=Priority email support (24hr response)
NEXT_PUBLIC_PLAN_TEAM_FEATURE_8=API access with higher rate limits
NEXT_PUBLIC_PLAN_TEAM_FEATURE_9=Shared brand profiles & assets
NEXT_PUBLIC_PLAN_TEAM_FEATURE_10=Usage analytics & reporting

# Department Plan
NEXT_PUBLIC_PLAN_DEPARTMENT_ID=department
NEXT_PUBLIC_PLAN_DEPARTMENT_NAME=Department
NEXT_PUBLIC_PLAN_DEPARTMENT_DESC=For departments and large organizations
NEXT_PUBLIC_PLAN_DEPT_FEATURE_1=Unlimited AI generations
NEXT_PUBLIC_PLAN_DEPT_FEATURE_2=Unlimited cloud storage
NEXT_PUBLIC_PLAN_DEPT_FEATURE_3=Unlimited team members
NEXT_PUBLIC_PLAN_DEPT_FEATURE_4=SSO & advanced security (SAML, OAuth)
NEXT_PUBLIC_PLAN_DECT_FEATURE_5=Dedicated account manager
NEXT_PUBLIC_PLAN_DEPT_FEATURE_6=Custom integrations & API
NEXT_PUBLIC_PLAN_DEPT_FEATURE_7=SLA guarantee (99.9% uptime)
NEXT_PUBLIC_PLAN_DEPT_FEATURE_8=Priority phone & chat support
NEXT_PUBLIC_PLAN_DECT_FEATURE_9=On-premise deployment option
NEXT_PUBLIC_PLAN_DECT_FEATURE_10=Custom training & onboarding
NEXT_PUBLIC_PLAN_DEPT_FEATURE_11=Advanced audit logs & compliance
NEXT_PUBLIC_PLAN_DECT_FEATURE_12=White-label options available

# Currency Settings
NEXT_PUBLIC_CURRENCY_SYMBOL=R
NEXT_PUBLIC_CURRENCY_CODE=ZAR

# Contact Sales URL
NEXT_PUBLIC_CONTACT_SALES_URL=mailto:sales@filo.ai

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_REGISTRATION=true
ENABLE_AI_GENERATION=true
ENABLE_PAYMENTS=false
ENABLE_ADMIN_PANEL=true

# -----------------------------------------------------------------------------
# Limits & Configuration
# -----------------------------------------------------------------------------
DEFAULT_CREDITS_LIMIT=100
FREE_STORAGE_LIMIT_MB=100
MAX_FILE_SIZE_MB=50
MAX_UPLOAD_FILES=10
JOB_TIMEOUT_MS=300000
JOB_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Security & Rate Limiting
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
