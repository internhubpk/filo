{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "../.build",
    "rootDir": "../../src",
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false,
    "noEmit": false,
    "baseUrl": "../..",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@convex/*": [
        "convex/*"
      ]
    },
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "../../src/types/index.ts",
    "../../src/services/themes.ts",
    "../../src/services/doc-scale.ts",
    "../../src/services/design-planning.ts",
    "../../src/services/artifact-planning.ts",
    "../../src/services/ingestion/types.ts",
    "../../src/services/ingestion/csv.ts",
    "../../src/services/ingestion/docx.ts",
    "../../src/services/ingestion/pdf.ts",
    "../../src/services/ingestion/xlsx.ts",
    "../../src/services/ingestion/pptx.ts",
    "../../src/services/ingestion/index.ts",
    "../../src/services/chart-engine.ts",
    "../../src/services/diagram-engine.ts",
    "../../src/services/typography/fonts.ts",
    "../../src/services/diagram/types.ts",
    "../../src/services/diagram/validate.ts",
    "../../src/services/diagram/svg.ts",
    "../../src/services/diagram/layout-graph.ts",
    "../../src/services/diagram/layout-custom.ts",
    "../../src/services/diagram/index.ts",
    "../../src/services/ast.ts",
    "../../src/services/math-engine.ts",
    "../../src/services/math-omml.ts",
    "../../src/services/formula-evaluator.ts",
    "../../src/services/render-target.ts",
    "../../src/services/qa/structural.ts",
    "../../src/services/renderers/shared.ts",
    "../../src/services/renderers/docx-renderer.ts",
    "../../src/services/renderers/pdf-renderer.ts",
    "../../src/services/renderers/pptx-renderer.ts",
    "../../src/services/renderers/xlsx-renderer.ts",
    "../../src/services/renderers/xlsx-formulas.ts",
    "../../src/services/renderers/text-renderers.ts",
    "../../src/services/document-renderer.ts",
    "../../src/lib/r2/client.ts",
    "../../src/lib/r2/errors.ts",
    "../../src/services/typography/inline.ts",
    "../../src/services/typography/code.ts"
  ]
}